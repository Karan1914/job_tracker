# Copy this file to .env and set your values.
# The tracker works without these — email notification is the only feature that needs them.

# Your email address to receive job tracker update notifications
NOTIFICATION_EMAIL=you@example.com

# The Gmail account used to send notifications (must match the App Password below)
SENDER_EMAIL=you@gmail.com

# Gmail App Password for the sender account.
# Generate one at: https://myaccount.google.com/apppasswords
# (2FA must be enabled on the Gmail account)
GMAIL_APP_PASSWORD=your_gmail_app_password_here
